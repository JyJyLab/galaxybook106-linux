+	LOG(IPU3Awb, Debug) << "Locus: grey world R/G " << rg << " B/G " << bg
+			    << " -> locus R/G " << pr << " B/G " << pb
+			    << " at " << ct << "K, distance " << best;
+
+	/* Allow a limited deviation from the locus. */
+	if (best > locusTolerance_) {
+		double k = locusTolerance_ / best;
+		rg = pr + (rg - pr) * k;
+		bg = pb + (bg - pb) * k;
+	}
+
+	asyncResults_.redGain = std::clamp(1.0 / rg, 0.0, 65535.0 / 8192);
+	asyncResults_.blueGain = std::clamp(1.0 / bg, 0.0, 65535.0 / 8192);
+	asyncResults_.temperatureK = ct;
+}
