+/*
+ * gbook: optional AWB locus from the camera module characterisation (the
+ * sensor's R/G and B/G response to neutral grey under calibration light
+ * sources). When present, the grey world estimate is constrained to stay
+ * within locusTolerance of the locus, and the colour temperature is read
+ * from the locus, as the Windows driver does.
+ */
+int Awb::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	locusTolerance_ = tuningData["locusTolerance"].get<double>(0.03);
+
+	const ValueNode &locus = tuningData["locus"];
+	if (!locus.isList())
+		return 0;
+
+	for (const ValueNode &p : locus.asList()) {
+		auto ct = p["ct"].get<double>();
+		auto rg = p["rg"].get<double>();
+		auto bg = p["bg"].get<double>();
+		if (!ct || !rg || !bg || *rg <= 0 || *bg <= 0) {
+			LOG(IPU3Awb, Error) << "Invalid locus point";
+			return -EINVAL;
+		}
+		locus_.push_back({ *ct, *rg, *bg });
+	}
+
+	std::sort(locus_.begin(), locus_.end(),
+		  [](const LocusPoint &a, const LocusPoint &b) { return a.ct < b.ct; });
+
+	if (locus_.size() < 2) {
+		LOG(IPU3Awb, Error) << "AWB locus needs at least 2 points";
+		return -EINVAL;
+	}
+
+	LOG(IPU3Awb, Debug) << "AWB locus with " << locus_.size() << " points";
+	return 0;
+}
+
+void Awb::applyLocus()
+{
+	double rg = 1.0 / asyncResults_.redGain;
+	double bg = 1.0 / asyncResults_.blueGain;
+
+	/* Closest point on the locus polyline. */
+	double best = std::numeric_limits<double>::max();
+	double pr = locus_.front().rg, pb = locus_.front().bg;
+	double ct = locus_.front().ct;
+	for (size_t i = 1; i < locus_.size(); i++) {
+		const LocusPoint &a = locus_[i - 1];
+		const LocusPoint &b = locus_[i];
+		double dr = b.rg - a.rg, db = b.bg - a.bg;
+		double t = ((rg - a.rg) * dr + (bg - a.bg) * db) / (dr * dr + db * db);
+		t = std::clamp(t, 0.0, 1.0);
+		double qr = a.rg + dr * t, qb = a.bg + db * t;
+		double d = std::hypot(rg - qr, bg - qb);
+		if (d < best) {
+			best = d;
+			pr = qr;
+			pb = qb;
+			/* Linear in mired along the segment. */
+			ct = 1e6 / (1e6 / a.ct + (1e6 / b.ct - 1e6 / a.ct) * t);
+		}
+	}
