@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * IPU3 colour correction matrix, interpolated by colour temperature
+ * (gbook: from the Windows camera module characterisation)
+ */
+
+#pragma once
+
+#include <array>
+#include <vector>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::ipu3::algorithms {
+
+class Ccm : public Algorithm
+{
+public:
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	void prepare(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     ipu3_uapi_params *params) override;
+
+private:
+	struct Entry {
+		double ct;
+		std::array<double, 9> m;
+	};
+
+	std::array<double, 9> interpolate(double ct) const;
+
+	std::vector<Entry> ccms_;
+};
+
+} /* namespace ipa::ipu3::algorithms */
+
+} /* namespace libcamera */
diff -ruN -x debian -x .pc -x 'obj-*' ../src/libcamera-0.7.2/src/ipa/ipu3/algorithms/lsc.cpp libcamera-0.7.2/src/ipa/ipu3/algorithms/lsc.cpp
--- ../src/libcamera-0.7.2/src/ipa/ipu3/algorithms/lsc.cpp	1970-01-01 00:00:00.000000000 +0000
+++ libcamera-0.7.2/src/ipa/ipu3/algorithms/lsc.cpp	2026-11-13 10:11:28.463937590 +0000
@@ -0,0 +1,292 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * IPU3 lens shading correction from full field of view gain grids
+ *
+ * The tuning data holds, as in the camera module characterisation used by
+ * the Windows driver, one gain grid per calibration light source for each
+ * Bayer channel, covering the full native field of view of the sensor in its
+ * native readout orientation. The grid for the current scene is interpolated
+ * in mired between the light sources around the AWB colour temperature.
+ *
+ * The ImgU applies shading correction on the Bayer down-scaler output, so the
+ * ImgU grid is laid out in BDS output pixels and every point is mapped back
+ * through the BDS, the input feeder crop (top left) and the sensor crop and
+ * binning to the native pixel array, accounting for sensor flips (deduced from
+ * the Bayer order the sensor reports).
+ */
+
+#include "lsc.h"
+
+#include <algorithm>
+#include <cmath>
+#include <stdlib.h>
+#include <string.h>
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/value_node.h"
+
+namespace libcamera {
+
+namespace ipa::ipu3::algorithms {
+
+LOG_DEFINE_CATEGORY(IPU3Lsc)
+
+namespace {
+
+/*
+ * ImgU shading gain: 1 + (lut << gain_factor) / 1024 with a 12 bit LUT, i.e.
+ * [1, 5] for gain_factor 0 as documented in the uAPI. Measured on the
+ * hardware by comparing frames with and without correction at fixed exposure
+ * and white balance (values above 4095 wrap around, gain_factor 1 doubles the
+ * correction).
+ */
+constexpr unsigned int kGainFactor = 0;
+constexpr double kLutOne = 1024.0;
+constexpr unsigned int kLutMax = 4095;
+
+/* Bayer orders as in properties::draft::ColorFilterArrangement. */
+int bayerFromName(const std::string &name)
+{
+	static const char *names[] = { "RGGB", "GRBG", "GBRG", "BGGR" };
+	for (int i = 0; i < 4; i++)
+		if (name == names[i])
+			return i;
+	return -1;
+}
+
+/* Bayer order after flipping a sensor whose native order is \a order. */
+unsigned int flipOrder(unsigned int order, bool hflip, bool vflip)
+{
+	if (hflip)
+		order ^= 1;
+	if (vflip)
+		order ^= 2;
+	return order;
+}
+
+} /* namespace */
+
+int LensShadingCorrection::init([[maybe_unused]] IPAContext &context,
+				const ValueNode &tuningData)
+{
+	auto grid = tuningData["gridSize"].get<std::vector<uint32_t>>();
+	auto scale = tuningData["scale"].get<double>(4096.0);
+	int order = bayerFromName(tuningData["bayerOrder"].get<std::string>("RGGB"));
+	if (!grid || grid->size() != 2 || (*grid)[0] < 2 || (*grid)[1] < 2 ||
+	    order < 0) {
+		LOG(IPU3Lsc, Error) << "Invalid gridSize or bayerOrder";
+		return -EINVAL;
+	}
+
+	gridWidth_ = (*grid)[0];
+	gridHeight_ = (*grid)[1];
+	bayerOrder_ = order;
+	size_t cells = gridWidth_ * gridHeight_;
+
+	static const char *channels[] = { "r", "gr", "gb", "b" };
+	for (const ValueNode &entry : tuningData["sets"].asList()) {
+		Set set;
+		set.ct = entry["ct"].get<double>(0.0);
+		for (unsigned int c = 0; c < 4; c++) {
+			auto values = entry[channels[c]].get<std::vector<uint16_t>>();
+			if (!values || values->size() != cells) {
+				LOG(IPU3Lsc, Error) << "Invalid grid '" << channels[c] << "'";
+				return -EINVAL;
+			}
+			set.gains[c].reserve(cells);
+			for (uint16_t v : *values)
+				set.gains[c].push_back(v / scale);
+		}
+		sets_.push_back(std::move(set));
+	}
+
+	if (sets_.empty()) {
+		LOG(IPU3Lsc, Error) << "No shading sets";
+		return -EINVAL;
+	}
+
+	std::sort(sets_.begin(), sets_.end(),
+		  [](const Set &a, const Set &b) { return a.ct < b.ct; });
+
+	LOG(IPU3Lsc, Debug) << sets_.size() << " shading sets, grid "
+			    << gridWidth_ << "x" << gridHeight_;
+	return 0;
+}
+
+int LensShadingCorrection::configure([[maybe_unused]] IPAContext &context,
+				     const IPAConfigInfo &configInfo)
+{
+	const IPACameraSensorInfo &sensor = configInfo.sensorInfo;
+	const Size &bds = configInfo.bdsOutputSize;
+	const Size &iif = configInfo.iif;
+
+	enabled_ = false;
+	if (bds.isNull() || iif.isNull() || sensor.outputSize.isNull() ||
+	    sensor.activeAreaSize.isNull())
+		return 0;
+
+	/* Sensor flips, from the Bayer order the sensor reports. */
+	bool hflip = false, vflip = false;
+	if (sensor.cfaPattern < 4) {
+		for (unsigned int f = 0; f < 4; f++) {
+			if (flipOrder(bayerOrder_, f & 1, f & 2) == sensor.cfaPattern) {
+				hflip = f & 1;
+				vflip = f & 2;
+				break;
+			}
+		}
+	}
+
+	/* Smallest ImgU cell that fits the LUT (146 cells per set, 28 sets). */
+	unsigned int log2 = 3, width = 0, height = 0, perSlice = 0;
+	for (; log2 <= 7; log2++) {
+		width = ((bds.width + (1u << log2) - 1) >> log2) + 1;
+		height = ((bds.height + (1u << log2) - 1) >> log2) + 1;
+		if (width < 8 || height < 8 || width > 128 || height > 128 ||
+		    width > IPU3_UAPI_SHD_MAX_CELLS_PER_SET)
+			continue;
+		perSlice = IPU3_UAPI_SHD_MAX_CELLS_PER_SET / width;
+		if ((height + perSlice - 1) / perSlice <= IPU3_UAPI_SHD_MAX_CFG_SETS)
+			break;
+	}
+	if (log2 > 7) {
+		LOG(IPU3Lsc, Warning) << "No shading grid fits " << bds;
+		return 0;
+	}
+
+	shd_ = {};
+	shd_.grid.width = width;
+	shd_.grid.height = height;
+	shd_.grid.block_width_log2 = log2;
+	shd_.grid.block_height_log2 = log2;
+	shd_.grid.grid_height_per_slice = perSlice;
+	shd_.grid.x_start = 0;
+	shd_.grid.y_start = 0;
+	shd_.general.shd_enable = 1;
+	shd_.general.gain_factor = kGainFactor;
+
+	/* Map every ImgU grid point to the calibration grid. */
+	const Rectangle &crop = sensor.analogCrop;
+	double cropW = crop.width ? crop.width : sensor.activeAreaSize.width;
+	double cropH = crop.height ? crop.height : sensor.activeAreaSize.height;
+	double activeW = sensor.activeAreaSize.width;
+	double activeH = sensor.activeAreaSize.height;
+
+	samples_.clear();
+	samples_.reserve(width * height);
+	for (unsigned int row = 0; row < height; row++) {
+		for (unsigned int col = 0; col < width; col++) {
+			/* BDS output pixel centre -> IF -> sensor output. */
+			double x = (col << log2) + 0.5;
+			double y = (row << log2) + 0.5;
+			x = x * iif.width / bds.width;
+			y = y * iif.height / bds.height;
+			/* Sensor output -> native pixel array. */
+			x = crop.x + x * cropW / sensor.outputSize.width;
+			y = crop.y + y * cropH / sensor.outputSize.height;
+			if (hflip)
+				x = activeW - x;
+			if (vflip)
+				y = activeH - y;
+
+			double gx = std::clamp(x / activeW, 0.0, 1.0) * (gridWidth_ - 1);
+			double gy = std::clamp(y / activeH, 0.0, 1.0) * (gridHeight_ - 1);
+			unsigned int ix = std::min<unsigned int>(gx, gridWidth_ - 2);
+			unsigned int iy = std::min<unsigned int>(gy, gridHeight_ - 2);
+			samples_.push_back({ iy * gridWidth_ + ix, gx - ix, gy - iy });
+		}
+	}
+
+	lutCt_ = 0.0;
+	enabled_ = true;
+
+	LOG(IPU3Lsc, Debug) << "Shading grid " << width << "x" << height
+			    << " cell " << (1u << log2) << " for BDS " << bds
+			    << ", IF " << iif << ", sensor " << sensor.outputSize
+			    << " crop " << crop << (hflip ? " hflip" : "")
+			    << (vflip ? " vflip" : "");
+	return 0;
+}
+
+void LensShadingCorrection::updateLut(double ct)
+{
+	/* Pick the two sets around ct, linear in mired. */
+	const Set *a = &sets_.front(), *b = &sets_.front();
+	double t = 0.0;
+	if (ct >= sets_.back().ct) {
+		a = b = &sets_.back();
+	} else if (ct > sets_.front().ct) {
+		for (size_t i = 1; i < sets_.size(); i++) {
+			if (ct <= sets_[i].ct) {
+				a = &sets_[i - 1];
+				b = &sets_[i];
+				t = (1e6 / a->ct - 1e6 / ct) / (1e6 / a->ct - 1e6 / b->ct);
+				break;
+			}
+		}
+	}
+
+	memset(&lut_, 0, sizeof(lut_));
+	unsigned int width = shd_.grid.width;
+	unsigned int perSlice = shd_.grid.grid_height_per_slice;
+
+	for (unsigned int n = 0; n < samples_.size(); n++) {
+		const Sample &s = samples_[n];
+		uint16_t v[4];
+		for (unsigned int c = 0; c < 4; c++) {
+			auto bilinear = [&](const std::vector<double> &g) {
+				double g00 = g[s.i00], g01 = g[s.i00 + 1];
+				double g10 = g[s.i00 + gridWidth_], g11 = g[s.i00 + gridWidth_ + 1];
+				double top = g00 + (g01 - g00) * s.fx;
+				double bot = g10 + (g11 - g10) * s.fx;
+				return top + (bot - top) * s.fy;
+			};
+			double gain = bilinear(a->gains[c]);
+			if (b != a)
+				gain += (bilinear(b->gains[c]) - gain) * t;
+			long q = std::lround((gain - 1.0) * kLutOne);
+			v[c] = std::clamp<long>(q, 0, kLutMax);
+		}
+
+		unsigned int row = n / width, col = n % width;
+		unsigned int set = row / perSlice;
+		unsigned int idx = (row % perSlice) * width + col;
+		lut_.sets[set].r_and_gr[idx].r = v[0];
+		lut_.sets[set].r_and_gr[idx].gr = v[1];
+		lut_.sets[set].gb_and_b[idx].gb = v[2];
+		lut_.sets[set].gb_and_b[idx].b = v[3];
+	}
+
+	lutCt_ = ct;
+}
+
+void LensShadingCorrection::prepare(IPAContext &context,
+				    const uint32_t frame,
+				    [[maybe_unused]] IPAFrameContext &frameContext,
+				    ipu3_uapi_params *params)
+{
+	if (!enabled_ || getenv("GBOOK_NO_LSC"))
+		return;
+
+	/* gbook: measurement knob, start shading correction at this frame. */
+	const char *from = getenv("GBOOK_LSC_FROM");
+	if (from && frame < strtoul(from, nullptr, 10))
+		return;
+
+	double ct = context.activeState.awb.temperatureK;
+	if (ct <= 0)
+		ct = 4500.0;
+	if (lutCt_ == 0.0 || std::abs(1e6 / ct - 1e6 / lutCt_) > 5.0)
+		updateLut(ct);
+
+	params->acc_param.shd.shd = shd_;
+	params->acc_param.shd.shd_lut = lut_;
+	params->use.acc_shd = 1;
+}
+
+REGISTER_IPA_ALGORITHM(LensShadingCorrection, "LensShadingCorrection")
+
+} /* namespace ipa::ipu3::algorithms */
