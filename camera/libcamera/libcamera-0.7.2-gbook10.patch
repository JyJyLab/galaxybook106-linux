+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * IPU3 lens shading correction from full field of view gain grids
+ * (gbook: from the Windows camera module characterisation)
+ */
+
+#pragma once
+
+#include <array>
+#include <vector>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::ipu3::algorithms {
+
+class LensShadingCorrection : public Algorithm
+{
+public:
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void prepare(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     ipu3_uapi_params *params) override;
+
+private:
+	struct Set {
+		double ct;
+		/* Gains for R, Gr, Gb, B on the calibration grid. */
+		std::array<std::vector<double>, 4> gains;
+	};
+
+	struct Sample {
+		unsigned int i00;
+		double fx;
+		double fy;
+	};
+
+	void updateLut(double ct);
+
+	unsigned int gridWidth_ = 0;
+	unsigned int gridHeight_ = 0;
+	unsigned int bayerOrder_ = 0;
+	std::vector<Set> sets_;
+
+	/* ImgU grid. */
+	ipu3_uapi_shd_config_static shd_ = {};
+	std::vector<Sample> samples_;
+	ipu3_uapi_shd_lut lut_ = {};
+	double lutCt_ = 0.0;
+	bool enabled_ = false;
+};
+
+} /* namespace ipa::ipu3::algorithms */
+
+} /* namespace libcamera */
