--- ../src/libcamera-0.7.2/src/ipa/ipu3/algorithms/ccm.cpp	1970-01-01 00:00:00.000000000 +0000
+++ libcamera-0.7.2/src/ipa/ipu3/algorithms/ccm.cpp	2026-11-13 10:06:46.519786065 +0000
@@ -0,0 +1,116 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * IPU3 colour correction matrix, interpolated by colour temperature
+ *
+ * The matrices are those of the camera module characterisation used by the
+ * Windows driver (one per calibration light source). As in that driver, the
+ * matrix for the current scene is interpolated linearly in reciprocal colour
+ * temperature (mired) between the two calibrated light sources around the
+ * AWB estimate, and clamped at both ends.
+ */
+
+#include "ccm.h"
+
+#include <algorithm>
+#include <cmath>
+#include <stdlib.h>
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/value_node.h"
+
+namespace libcamera {
+
+namespace ipa::ipu3::algorithms {
+
+LOG_DEFINE_CATEGORY(IPU3Ccm)
+
+int Ccm::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	const ValueNode &list = tuningData["ccms"];
+	if (!list.isList()) {
+		LOG(IPU3Ccm, Error) << "'ccms' missing";
+		return -EINVAL;
+	}
+
+	for (const ValueNode &entry : list.asList()) {
+		auto ct = entry["ct"].get<double>();
+		auto m = entry["ccm"].get<std::vector<double>>();
+		if (!ct || !m || m->size() != 9) {
+			LOG(IPU3Ccm, Error) << "Invalid ccm entry";
+			return -EINVAL;
+		}
+		Entry e;
+		e.ct = *ct;
+		std::copy(m->begin(), m->end(), e.m.begin());
+		ccms_.push_back(e);
+	}
+
+	std::sort(ccms_.begin(), ccms_.end(),
+		  [](const Entry &a, const Entry &b) { return a.ct < b.ct; });
+
+	LOG(IPU3Ccm, Debug) << ccms_.size() << " colour matrices";
+	return 0;
+}
+
+std::array<double, 9> Ccm::interpolate(double ct) const
+{
+	if (ct <= ccms_.front().ct)
+		return ccms_.front().m;
+	if (ct >= ccms_.back().ct)
+		return ccms_.back().m;
+
+	for (size_t i = 1; i < ccms_.size(); i++) {
+		const Entry &a = ccms_[i - 1];
+		const Entry &b = ccms_[i];
+		if (ct > b.ct)
+			continue;
+
+		/* Linear in mired. */
+		double t = (1e6 / a.ct - 1e6 / ct) / (1e6 / a.ct - 1e6 / b.ct);
+		std::array<double, 9> m;
+		for (unsigned int k = 0; k < 9; k++)
+			m[k] = a.m[k] + (b.m[k] - a.m[k]) * t;
+		return m;
+	}
+
+	return ccms_.back().m;
+}
+
+void Ccm::prepare(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		  [[maybe_unused]] IPAFrameContext &frameContext,
+		  ipu3_uapi_params *params)
+{
+	if (getenv("GBOOK_NO_CCM") || getenv("GBOOK_LINEAR"))
+		return;
+
+	double ct = context.activeState.awb.temperatureK;
+	std::array<double, 9> m = interpolate(ct > 0 ? ct : 4500.0);
+
+	/* ImgU CCM coefficients: 8192 = 1.0, offsets unused. */
+	auto q = [](double v) {
+		return static_cast<int16_t>(std::clamp(std::lround(v * 8192), -32768L, 32767L));
+	};
+
+	ipu3_uapi_ccm_mat_config &ccm = params->acc_param.ccm;
+	ccm.coeff_m11 = q(m[0]);
+	ccm.coeff_m12 = q(m[1]);
+	ccm.coeff_m13 = q(m[2]);
+	ccm.coeff_o_r = 0;
+	ccm.coeff_m21 = q(m[3]);
+	ccm.coeff_m22 = q(m[4]);
+	ccm.coeff_m23 = q(m[5]);
+	ccm.coeff_o_g = 0;
+	ccm.coeff_m31 = q(m[6]);
+	ccm.coeff_m32 = q(m[7]);
+	ccm.coeff_m33 = q(m[8]);
+	ccm.coeff_o_b = 0;
+
+	params->use.acc_ccm = 1;
+}
+
+REGISTER_IPA_ALGORITHM(Ccm, "Ccm")
+
+} /* namespace ipa::ipu3::algorithms */
+
+} /* namespace libcamera */
