+/* gbook: publish the visibility in $XDG_RUNTIME_DIR/wvkbd-gbook.visible ("1"/"0")
+ * so that gbook-osk-auto can show the keyboard again when a text field that
+ * still has the focus is tapped after the keyboard was hidden with the key */
+static void
+gbook_state(int visible)
+{
+    const char *dir = getenv("XDG_RUNTIME_DIR");
+    char path[512];
+    FILE *f;
+    if (!dir)
+        return;
+    snprintf(path, sizeof(path), "%s/wvkbd-gbook.visible", dir);
+    if ((f = fopen(path, "w"))) {
+        fputs(visible ? "1\n" : "0\n", f);
+        fclose(f);
+    }
+}
