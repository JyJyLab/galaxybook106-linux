+/* Show the Korean or the Latin labels on the alphabetical layer. Both layers
+ * send the same key codes; the input method (fcitx5) does the composing, so
+ * this only has to follow the state of the input method. Returns true when
+ * the layout on screen changed and has to be drawn again. */
+bool
+kbd_set_language(struct kbd *kb, bool korean)
+{
+    enum layout_id to_id = korean ? Korean : Full;
+    enum layout_id from_id = korean ? Full : Korean;
+    struct layout *from = &kb->layouts[from_id], *to = &kb->layouts[to_id];
+    enum layout_id *lists[2] = {kb->layers, kb->landscape_layers};
+    bool changed = false;
+
+    kb->korean = korean;
+    for (int n = 0; n < 2; n++) {
+        if (!lists[n])
+            continue;
+        for (size_t i = 0; lists[n][i] != NumLayouts; i++) {
+            if (lists[n][i] == from_id)
+                lists[n][i] = to_id;
+        }
+    }
+    if (kb->last_abc_layout == from)
+        kb->last_abc_layout = to;
+    if (kb->prevlayout == from)
+        kb->prevlayout = to;
+    if (kb->layout == from) {
+        kb->layout = to;
+        changed = true;
+    }
+    return changed;
+}
+
